+
+      const finalIndexConstants = [...source.matchAll(/(?:const|let)\s+([A-Za-z_$][\w$]*)\s*=\s*[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*\.length\s*-\s*1/g)];
+      return finalIndexConstants.some((constant) => new RegExp(`\\b${indexName}\\s*===\\s*${escapeRegExp(constant[1])}\\b`).test(source));
+    });
+    if (!hasLastCondition) {
+      issues.push(createIssue(file, line, 'bem-modifier', `TSX 必须以末项判断同挂 ${modifier}`));
+    }
+  }
+
+  for (const requestedModifier of requiredSingleModifiers) {
+    const modifier = requestedModifier.endsWith('--bar') ? requestedModifier : `${requestedModifier}--bar`;
+    const baseClass = modifier.slice(0, -'--bar'.length);
+    const modifierOffset = source.indexOf(modifier);
+    const line = lineNumberAt(source, Math.max(modifierOffset, 0));
+    const classNamePattern = new RegExp(`className\\s*=\\s*(?:["'][^"']*${escapeRegExp(modifier)}|\\{[\\s\\S]{0,500}?${escapeRegExp(modifier)})`);
+    const singleCondition = /\b[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*\.length\s*===\s*1\b|\b1\s*===\s*[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*\.length\b/;
+
+    if (!classNamePattern.test(source) || !source.includes(baseClass) || !singleCondition.test(source)) {
+      issues.push(createIssue(file, line, 'single-item-modifier', `TSX 必须以列表长度为 1 的判断同挂 ${baseClass} 与 ${modifier}`));
+    }
+  }
