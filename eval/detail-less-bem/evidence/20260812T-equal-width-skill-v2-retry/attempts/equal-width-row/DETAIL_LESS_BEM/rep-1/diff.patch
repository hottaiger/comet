+const lastActionIndex = actions.length - 1;
+actions.map((action, index) => (
+  <Text
+    className={
+      index === lastActionIndex
+        ? 'service-card__action service-card__action--last'
+        : 'service-card__action'
+    }
+  >
+    {action}
+  </Text>
+));
+`, {
+      requiredLastModifiers: ['service-card__action--last'],
+    }),
+    [],
+  );
+});
+
+test('requires a single-item fallback modifier to be gated by a list length check', () => {
+  const issues = validateComponent(`
