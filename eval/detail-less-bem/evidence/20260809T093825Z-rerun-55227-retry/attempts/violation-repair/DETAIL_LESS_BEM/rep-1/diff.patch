+export function validateTsx(source, file = '<input>', { requiredLastModifiers = [] } = {}) {
+  const issues = [];
+
+  for (const requestedModifier of requiredLastModifiers) {
+    const modifier = requestedModifier.endsWith('--last') ? requestedModifier : `${requestedModifier}--last`;
+    const baseClass = modifier.slice(0, -'--last'.length);
+    const modifierOffset = source.indexOf(modifier);
+    const line = lineNumberAt(source, Math.max(modifierOffset, 0));
