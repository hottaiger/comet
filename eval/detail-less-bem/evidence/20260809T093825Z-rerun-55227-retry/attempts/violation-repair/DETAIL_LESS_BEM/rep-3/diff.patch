ule === 'bem-selector'));\n63\t  assert.ok(issues.some((issue) => issue.rule === 'empty-rule'));\n64\t});\n65\t\n66\ttest('allows a non-RN property inside a lowercase #ifndef rn block', () => {\n67\t  assert.deepEqual(\n68\t    validate(`\n69\t.vehicle-card {\n70\t  /* #ifndef rn */\n71\t  box-shadow: 0 2px 4px #000;\n72\t  /* #endif */\n73\t}\n74\t`),\n75\t    [],\n76\t  );\n77\t});\n78\t\n79\ttest('allows multi-platform style conditions and rejects uppercase platform names', () => {\n80\t  const valid = validate(`\n81\t.vehicle-card {\n82\t  /* #ifdef h5 weapp */\n83\t  position: fixed;\n84\t  /* #endif */\n85\t}\n86\t`);\n87\t  const invalid = validate(`\n88\t.vehicle-card {\n89\t  /* #ifdef RN */\n90\t  color: #111;\n91\t  /* #endif */\n92\t}\n93\t`);\n94\t\n95\t  assert.deepEqual(valid, []);\n96\t  assert.ok(invalid.some((issue) => issue.rule === 'platform-condition'));\n97\t});\n98\t\n99\ttest('requires border-box for width 100 percent with horizontal padding', () => {\n100\t  const issues = validate(`\n101\t.vehicle-card {\n102\t  width: 100%;\n103\t  padding-left: 12px;\n104\t}\n105\t`);\n106\t\n107\t  assert.ok(issues.some((issue) => issue.rule === 'width-padding-box-sizing'));\n108\t});\n109\t\n110\ttest('requires a px value for public line-height', () => {\n111\t  const issues = validate(`\n112\t.vehicle-card__title {\n113\t  line-height: 1.5;\n114\t}\n115\t\n116\t.vehicle-card__subtitle {\n117\t  line-height: normal;\n118\t}\n119\t\n120\t.vehicle-card__caption {\n121\t  line-height: 120%;\n122\t}\n123\t`);\n124\t\n125\t  assert.equal(issues.filter((issue) => issue.rule === 'line-height-px').length, 3);\n126\t});\n127\t\n128\ttest('requires a list item to apply an existing last-item modifier with an index condition', () => {\n129\t  const issues = validateComponent(`\n130\tconst actions = ['\u9884\u7ea6\u770b\u8f66', '\u5728\u7ebf\u54a8\u8be2'];\n131\tactions.map((action) => <Text className=\"service-card__action\">{action}</Text>);\n132\t`, {\n133\t    r