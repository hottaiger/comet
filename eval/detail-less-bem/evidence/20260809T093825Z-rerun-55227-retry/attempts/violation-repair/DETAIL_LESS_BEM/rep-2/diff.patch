+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { validateLess, validateTsx } from '../scripts/check-public-less.mjs';
+
+const validate = (source) => validateLess(source, 'fixture.less');
+const validateComponent = (source, options) => validateTsx(source, 'fixture.tsx', options);
+
+test('accepts a top-level BEM selector and a compliant layout rule', () => {
+  assert.deepEqual(
+    validate(`
+.vehicle-card__title--compact {
+  width: 100%;
+  padding-left: 12px;
+  padding-right: 12px;
+  box-sizing: border-box;
+}
+`),
+    [],
+  );
+});
+
+test('rejects forbidden public properties', () => {
+  const issues = validate(`
+.vehicle-card {
+  gap: 12px;
+}
+`);
+
+  assert.equal(issues.length, 1);
+  assert.match(issues[0].message, /gap/);
+  assert.equal(issues[0].line, 3);
+});
+
+test('rejects nested and compound selectors', () => {
+  const issues = validate(`
+.vehicle-card {
+  .vehicle-card__title {
+    color: #111;
+  }
+}
+`);
+
+  assert.ok(issues.some((issue) => issue.rule === 'top-level-single-selector'));
+});
+
+test('rejects pseudo selectors, non-BEM selectors, and empty rules', () => {
+  const issues = validate(`
+.vehicle-card:hover {
+  color: #111;
+}
+
+.vehicle-card__title__label {
+  color: #111;
+}
+
+.vehicle-card__empty {
+}
+`);
+
+  assert.ok(issues.some((issue) => issue.rule === 'bem-selector'));
+  assert.ok(issues.some((issue) => issue.rule === 'bem-selector'));
+  assert.ok(issues.some((issue) => issue.rule === 'empty-rule'));
+});
+
+test('allows a non-RN property inside a lowercase #ifndef rn block', () => {
+  assert.deepEqual(
+    validate(`
+.vehicle-card {
+  /* #ifndef rn */
+  box-shadow: 0 2px 4px #000;
+  /* #endif */
+}
+`),
+    [],
+  );
+});
+
+test('allows multi-platform style conditions and rejects uppercase platform names', () => {
+  const valid = validate(`
+.vehicle-card {
+  /* #ifdef h5 weapp */
+  position: fixed;
+  /* #endif */
+}
+`);
+  const invalid = validate(`
+.vehicle-card {
+  /* #ifdef RN */
+  color: #111;
+  /* #endif */
+}
+`);
+
+  assert.deepEqual(valid, []);
+  assert.ok(invalid.some((issue) => issue.rule === 'platform-condition'));
+});
+
+test('requires border-box for width 100 percent with horizontal padding', () => {
+  const issues = validate(`
+.vehicle-card {
+  width: 100%;
+  padding-left: 12px;
+}
+`);
+
+  assert.ok(issues.some((issue) => issue.rule === 'width-padding-box-sizing'));
+});
+
+test('requires a px value for public line-height', () => {
+  const issues = validate(`
+.vehicle-card__title {
+  line-height: 1.5;
+}
+
+.vehicle-card__subtitle {
+  line-height: normal;
+}
+
+.vehicle-card__caption {
+  line-height: 120%;
+}
+`);
+
+  assert.equal(issues.filter((issue) => issue.rule === 'line-height-px').length, 3);
+});
+
+test('requires a list item to apply an existing last-item modifier with an index condition', () => {
+  const issues = validateComponent(`
+const actions = ['预约看车', '在线咨询'];
+actions.map((action) => <Text className="service-card__action">{action}</Text>);
+`, {
+    requiredLastModifiers: ['service-card__action--last'],
+  });
+
+  assert.ok(issues.some((issue) => issue.rule === 'bem-modifier'));
+});
+
+test('accepts a list item whose final entry applies its base class and last modifier together', () => {
+  assert.deepEqual(
+    validateComponent(`
+const actions = ['预约看车', '在线咨询'];
+actions.map((action, index) => (
+  <Text
+    className={
+      index === actions.length - 1
+        ? 'service-card__action service-card__action--last'
+        : 'service-card__action'
+    }
+  >
+    {action}
+  </Text>
+));
+`, {
+      requiredLastModifiers: ['service-card__action--last'],
+    }),
+    [],
+  );
+});
+
+test('accepts a named final-index constant used by a list item modifier', () => {
+  assert.deepEqual(
+    validateComponent(`
+const actions = ['预约看车', '在线咨询'];
+const lastActionIndex = actions.length - 1;
+actions.map((action, index) => (
+  <Text
+    className={
+      index === lastActionIndex
+        ? 'service-card__action service-card__action--last'
+        : 'service-card__action'
+    }
+  >
+    {action}
+  </Text>
+));
+`, {
+      requiredLastModifiers: ['service-card__action--last'],
+    }),
+    [],
+  );
+});
