+
+export function validateTsx(source, file = '<input>', { requiredLastModifiers = [] } = {}) {
+  const issues = [];
+
+  for (const requestedModifier of requiredLastModifiers) {
+    const modifier = requestedModifier.endsWith('--last') ? requestedModifier : `${requestedModifier}--last`;
+    const baseClass = modifier.slice(0, -'--last'.length);
+    const modifierOffset = source.indexOf(modifier);
+    const line = lineNumberAt(source, Math.max(modifierOffset, 0));
+    const classNamePattern = new RegExp(`className\\s*=\\s*(?:["'][^"']*${escapeRegExp(modifier)}|\\{[\\s\\S]{0,500}?${escapeRegExp(modifier)})`);
+
+    if (!classNamePattern.test(source) || !source.includes(baseClass)) {
+      issues.push(createIssue(file, line, 'bem-modifier', `TSX 必须在循环渲染元素上同挂 ${baseClass} 与 ${modifier}`));
+      continue;
+    }
+
+    const mapMatches = [...source.matchAll(/\.map\s*\(\s*\(\s*[^,)]*\s*,\s*([A-Za-z_$][\w$]*)\s*\)/g)];
+    const hasLastCondition = mapMatches.some((match) => {
+      const indexName = escapeRegExp(match[1]);
+      const directCondition = new RegExp(`\\b${indexName}\\s*===\\s*[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*\\.length\\s*-\\s*1`);
+      if (directCondition.test(source)) return true;
+
+      const finalIndexConstants = [...source.matchAll(/(?:const|let)\s+([A-Za-z_$][\w$]*)\s*=\s*[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*\.length\s*-\s*1/g)];
+      return finalIndexConstants.some((constant) => new RegExp(`\\b${indexName}\\s*===\\s*${escapeRegExp(constant[1])}\\b`).test(source));
+    });
+    if (!hasLastCondition) {
+      issues.push(createIssue(file, line, 'bem-modifier', `TSX 必须以末项判断同挂 ${modifier}`));
+    }
+  }
+
+  return issues;
+}
+
+function changedLessFiles() {
+  try {
+    return execFileSync('git', ['diff', '--name-only', '--diff-filter=ACMR', '--', '*.less'], { encoding: 'utf8' })
+      .split(/\r?\n/)
+      .filter(Boolean);
+  } catch {
+    return [];
+  }
+}
+
+function main() {
+  const args = process.argv.slice(2);
+  const lessTargets = [];
+  const tsxTargets = [];
+  const requiredLastModifiers = [];
+  for (let index = 0; index < args.length; index += 1) {
+    const arg = args[index];
+    if (arg === '--tsx') {
+      tsxTargets.push(args[++index]);
+    } else if (arg === '--require-last') {
+      requiredLastModifiers.push(args[++index]);
+    } else {
+      lessTargets.push(arg);
+    }
+  }
+
+  const targets = lessTargets.length > 0 ? lessTargets : tsxTargets.length > 0 ? [] : changedLessFiles();
+  if (targets.length === 0 && tsxTargets.length === 0) {
+    console.log('未发现本次修改的 Less 文件或指定的 TSX 文件。');
+    return;
+  }
+
+  const issues = targets.flatMap((file) => {
+    if (!existsSync(file)) return [createIssue(file, 0, 'file', '文件不存在')];
+    return validateLess(readFileSync(file, 'utf8'), path.normalize(file));
+  }).concat(tsxTargets.flatMap((file) => {
+    if (!existsSync(file)) return [createIssue(file, 0, 'file', '文件不存在')];
+    return validateTsx(readFileSync(file, 'utf8'), path.normalize(file), { requiredLastModifiers });
+  }));
+  if (issues.length === 0) {
+    console.log(`PASS ${targets.length} 个 Less 文件，${tsxTargets.length} 个 TSX 文件`);
+    return;
+  }
+
+  for (const issue of issues) {
+    console.error(`${issue.file}:${issue.line} [${issue.rule}] ${issue.message}`);
+  }
+  process.exitCode = 1;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) main();
