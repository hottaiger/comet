age',\n17\t  'background',\n18\t  'outline',\n19\t  'visibility',\n20\t  'transition',\n21\t  'animation',\n22\t  'text-overflow',\n23\t  'white-space',\n24\t  'word-break',\n25\t]);\n26\tconst BEM_SELECTOR = /^\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:__(?:[a-z0-9]+(?:-[a-z0-9]+)*))?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?$/;\n27\t\n28\tfunction parseCondition(line, lineNumber) {\n29\t  const match = line.match(/^\\s*\\/\\*\\s*#(ifdef|ifndef)\\s+([^*]+?)\\s*\\*\\/\\s*$/);\n30\t  if (!match) return null;\n31\t\n32\t  const platforms = match[2].trim().split(/\\s+/);\n33\t  const invalidPlatform = platforms.find((platform) => !PLATFORMS.has(platform));\n34\t  if (invalidPlatform) {\n35\t    return {\n36\t      issue: {\n37\t        file: '',\n38\t        line: lineNumber,\n39\t        rule: 'platform-condition',\n40\t        message: `\u6761\u4ef6\u7f16\u8bd1\u5e73\u53f0\u5fc5\u987b\u4f7f\u7528\u5c0f\u5199 rn\u3001h5\u3001weapp\uff0c\u5f53\u524d\u4e3a ${invalidPlatform}`,\n41\t      },\n42\t    };\n43\t  }\n44\t  return { type: match[1], platforms };\n45\t}\n46\t\n47\tfunction getIncludedPlatforms(conditionStack) {\n48\t  let included = new Set(PLATFORMS);\n49\t  for (const condition of conditionStack) {\n50\t    if (condition.type === 'ifdef') {\n51\t      included = new Set([...included].filter((platform) => condition.platforms.includes(platform)));\n52\t    } else {\n53\t      included = new Set([...included].filter((platform) => !condition.platforms.includes(platform)));\n54\t    }\n55\t  }\n56\t  return included;\n57\t}\n58\t\n59\tfunction createIssue(file, line, rule, message) {\n60\t  return { file, line, rule, message };\n61\t}\n62\t\n63\tfunction isForbiddenDeclaration(property, value) {\n64\t  if (FORBIDDEN_PROPERTIES.has(property)) return true;\n65\t  if (property === 'position' && /\\b(?:fixed|sticky)\\b/.test(value)) return true;\n66\t  if (property === 'border-style' && /\\bnone\\b/.test(value)) return true;\n67\t  if (property === 'transform' && /translateZ\\s*\\(/i.te